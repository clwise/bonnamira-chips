      var off = shown && !jewelOn();
      document.body.classList.toggle('ob-jewel-off', !!off);
      var b = ensure(), want = !(off && coreReady()); if (b && b.hidden !== want) b.hidden = want;
    } finally { busy = false; }
  }
  function start() { var root = document.getElementById('outfit-builder'); if (!root) return; new MutationObserver(sync).observe(root, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden', 'class'] }); sync(); }
