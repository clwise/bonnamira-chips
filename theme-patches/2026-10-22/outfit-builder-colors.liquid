    bar.innerHTML = '<p>' + JP.msg + '</p><button type="button" id="obj-go">' + JP.btn + '</button>';
    board.parentNode.insertBefore(bar, board);
    bar.querySelector('button').addEventListener('click', function () {
      var s = readState(); if (!s || !s.answers) return;
      s.answers.jewelryOn = true; s.t = Date.now();
      try { sessionStorage.setItem(STORE, JSON.stringify(s)); } catch (e) { return; }
      location.hash = '#look'; location.reload();
    });
    return bar;
  }
  var busy = false;
  function sync() {
    if (busy) return; busy = true;
    try {
