{%- case request.locale.iso_code -%}
{%- when 'es' -%}{%- assign ob_q_style = '¿Una pieza, o top y parte de abajo?' -%}{%- assign ob_style_one = 'Una pieza' -%}
{%- when 'fr' -%}{%- assign ob_q_style = 'Une pièce, ou un haut et un bas ?' -%}{%- assign ob_style_one = 'Une pièce' -%}
{%- when 'ar' -%}{%- assign ob_q_style = 'قطعة واحدة، أم بلوزة وقطعة سفلية؟' -%}{%- assign ob_style_one = 'قطعة واحدة' -%}
{%- when 'th' -%}{%- assign ob_q_style = 'อยากได้ชุดชิ้นเดียว หรือเสื้อกับท่อนล่าง?' -%}{%- assign ob_style_one = 'ชุดชิ้นเดียว' -%}
{%- else -%}{%- assign ob_q_style = 'Are you going for a one-piece, or a top and bottom?' -%}{%- assign ob_style_one = 'One piece' -%}
{%- endcase -%}
<section class="ob" id="outfit-builder" aria-live="polite">
<div class="ob-wrap">
<header class="ob-head">
<p class="ob-kicker">{{ 'ob.kicker_html' | t }}</p>
<h1 class="ob-title">{{ 'ob.title_html' | t }}</h1>
<p class="ob-sub">{{ 'ob.sub_html' | t }}</p>
<p class="ob-offer"><span class="ob-offer-badge">{{ 'ob.offer_badge_html' | t }}</span> {{ 'ob.offer_text_html' | t }}</p>
</header>
<div class="ob-progress" id="ob-progress" aria-hidden="true"></div>
<p class="ob-step-label" id="ob-step-label"></p>
<div id="ob-steps">
<fieldset class="ob-panel" data-step="occasion">
<legend class="ob-q">{{ 'ob.q_occasion_html' | t }}</legend>
<div class="ob-grid" data-field="occasion">
<button type="button" class="ob-chip" data-value="casual">{{ 'ob.chip_casual_html' | t }}</button>
<button type="button" class="ob-chip" data-value="brunch">{{ 'ob.chip_brunch_html' | t }}</button>
<button type="button" class="ob-chip" data-value="dinner">{{ 'ob.chip_dinner_html' | t }}</button>
<button type="button" class="ob-chip" data-value="clubbing">{{ 'ob.chip_clubbing_html' | t }}</button>
<button type="button" class="ob-chip" data-value="after-hours">{{ 'ob.chip_after_html' | t }}</button>
<button type="button" class="ob-chip" data-value="formal">{{ 'ob.chip_formal_html' | t }}</button>
<button type="button" class="ob-chip" data-value="gala">{{ 'ob.chip_gala_html' | t }}</button>
<button type="button" class="ob-chip" data-value="gym">{{ 'ob.chip_gym_html' | t }}</button>
<button type="button" class="ob-chip" data-value="beach">{{ 'ob.chip_beach_html' | t }}</button>
</div>
</fieldset>
<fieldset class="ob-panel" data-step="style" hidden>
<legend class="ob-q">{{ ob_q_style }}</legend>
<div class="ob-grid ob-grid-cards" data-field="style">
<button type="button" class="ob-card" data-value="dress">
<span class="ob-card-title">{{ ob_style_one }}</span>
<span class="ob-card-sub">{{ 'ob.style_dress_sub_html' | t }}</span>
</button>
<button type="button" class="ob-card" data-value="separates">
<span class="ob-card-title">{{ 'ob.style_sep_html' | t }}</span>
<span class="ob-card-sub">{{ 'ob.style_sep_sub_html' | t }}</span>
</button>
</div>
</fieldset>
<fieldset class="ob-panel" data-step="size" hidden>
<legend class="ob-q">{{ 'ob.q_sizes_html' | t }}</legend>
<form class="ob-sizes" id="ob-sizes" novalidate autocomplete="off">
<div class="ob-sizes-rows" id="ob-sizes-rows"></div>
<button type="submit" class="ob-sizes-go">{{ 'ob.continue_html' | t }}</button>
</form>
<p class="ob-hint">{{ 'ob.size_hint_html' | t }}</p>
</fieldset>
<fieldset class="ob-panel" data-step="finish" hidden>
<legend class="ob-q">{{ 'ob.q_finish_html' | t }}</legend>
<div class="ob-grid ob-grid-cards" data-field="finish">
<button type="button" class="ob-card ob-card-visual" data-value="solid">
<span class="ob-finish-art ob-finish-solid" aria-hidden="true"><i></i><i></i><i></i></span>
<span class="ob-card-title">{{ 'ob.solids_html' | t }}</span>
<span class="ob-card-sub" data-count="solid"></span>
</button>
<button type="button" class="ob-card ob-card-visual" data-value="print">
<span class="ob-finish-art ob-finish-print" aria-hidden="true"></span>
<span class="ob-card-title">{{ 'ob.prints_html' | t }}</span>
<span class="ob-card-sub" data-count="print"></span>
</button>
<button type="button" class="ob-card ob-card-visual" data-value="">
<span class="ob-finish-art ob-finish-any" aria-hidden="true">?</span>
<span class="ob-card-title">{{ 'ob.surprise_html' | t }}</span>
<span class="ob-card-sub">{{ 'ob.surprise_sub_html' | t }}</span>
</button>
</div>
</fieldset>
<fieldset class="ob-panel" data-step="color" hidden>
<legend class="ob-q">{{ 'ob.q_color_html' | t }}</legend>
<p class="ob-hint ob-hint-top">{{ 'ob.color_hint_html' | t }}</p>
<div class="ob-grid ob-grid-swatches" data-field="color"></div>
</fieldset>
<fieldset class="ob-panel" data-step="pattern" hidden>
<legend class="ob-q">{{ 'ob.q_print_html' | t }}</legend>
<p class="ob-hint ob-hint-top">{{ 'ob.print_hint_html' | t }}</p>
<div class="ob-grid ob-grid-swatches" data-field="pattern"></div>
</fieldset>
<fieldset class="ob-panel" data-step="pickHero" hidden>
<legend class="ob-q" id="ob-pickhero-q">{{ 'ob.pick_dress_html' | t }}</legend>
<p class="ob-hint ob-hint-top" id="ob-pickhero-hint"></p>
<div class="ob-choices" id="ob-pickhero-grid"></div>
<p class="ob-choices-more"><button type="button" class="ob-reroll" data-reroll="hero" hidden>&#8635; {{ 'ob.reroll_choices_html' | t }}</button></p>
</fieldset>
<fieldset class="ob-panel" data-step="pickBottom" hidden>
<legend class="ob-q">{{ 'ob.q_bottom_html' | t }}</legend>
<p class="ob-hint ob-hint-top" id="ob-pickbottom-hint">{{ 'ob.bottom_hint_html' | t }}</p>
<div class="ob-choices" id="ob-pickbottom-grid"></div>
<p class="ob-choices-more"><button type="button" class="ob-reroll" data-reroll="bottom" hidden>&#8635; {{ 'ob.reroll_choices_html' | t }}</button></p>
</fieldset>
<fieldset class="ob-panel" data-step="shoe" hidden>
<legend class="ob-q" id="ob-shoe-q">{{ 'ob.q_shoe_html' | t }}</legend>
<p class="ob-hint ob-hint-top" id="ob-shoe-hint"></p>
<div class="ob-grid ob-grid-cards" data-field="shoeKind" id="ob-shoe-grid"></div>
</fieldset>
</div>
<div class="ob-nav">
<button type="button" class="ob-back" id="ob-back" hidden>{{ 'ob.back_html' | t }}</button>
<button type="button" class="ob-restart" id="ob-restart" hidden>{{ 'ob.restart_html' | t }}</button>
</div>
<div class="ob-results" id="ob-results" hidden>
<div class="ob-res-head">
<p class="ob-res-kicker">{{ 'ob.kicker_html' | t }}</p>
<h2 class="ob-results-title">{{ 'ob.your_look_html' | t }}</h2>
<p class="ob-results-sub" id="ob-results-sub"></p>
<span class="ob-res-rule" aria-hidden="true"></span>
<div class="ob-reroll-row">
<button type="button" class="ob-reroll-ink" id="ob-reroll-outfit" aria-label="{{ 'ob.reroll_all_aria_html' | t }}">{{ 'ob.reroll_all_html' | t }} <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 12a8 8 0 0 1-14 5.3M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4M6 21v-4h4"/></svg></button>
<button type="button" class="ob-reroll-ink ob-reroll-jewel" id="ob-reroll-jewel" aria-label="{{ 'ob.reroll_jewel_aria_html' | t }}">{{ 'ob.reroll_jewel_html' | t }} <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 6 3-6M12 9v12"/></svg></button>
</div>
<p class="ob-lock-hint">{{ 'ob.lock_hint_a_html' | t }} <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> {{ 'ob.lock_hint_b_html' | t }}</p>
</div>
<p class="ob-palette" id="ob-palette"></p>
<div class="ob-board" id="ob-board">
<nav class="ob-rail" id="ob-rail" aria-label="{{ 'ob.pieces_nav_html' | t }}"></nav>
<div class="ob-lay" id="ob-lay"></div>
<div class="ob-tray" id="ob-tray" aria-live="polite"></div>
<div class="ob-detail" id="ob-detail" aria-live="polite"></div>
</div>
<div class="ob-occ" id="ob-occ"></div>
<div class="ob-summary" id="ob-summary"></div>
</div>
<div class="ob-loading" id="ob-loading" hidden><p>{{ 'ob.loading_html' | t }}</p></div>
</div>
</section>
{%- render 'post-add-modal' -%}
<script src="{{ 'outfit-builder-engine.js' | asset_url }}" defer></script>
